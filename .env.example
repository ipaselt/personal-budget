# Copy this file to `.env` and fill in your Plaid keys.
# Get them at: https://dashboard.plaid.com/  ->  Developers -> Keys
# NEVER commit the real .env (it is gitignored).

# "sandbox" = free fake-bank data (use this while building).
# Switch to "production" once your Plaid Production access is approved.
PLAID_ENV=sandbox

# Your Plaid client_id (same across all environments).
PLAID_CLIENT_ID=

# Your secret for the environment named in PLAID_ENV above.
# Sandbox secret while testing; Production secret after approval.
PLAID_SECRET=

# Port the local server listens on.
PORT=4000
